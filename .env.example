# Kantar - optional overrides for the local stack.
#
# You do not need this file to run Kantar: scripts/local-stack.ps1 sets these variables itself and
# generates every password into the git-ignored .local/ directory. This file only documents the
# variables compose.yaml reads. Copy to .env to override; .env is git-ignored.
#
# There are NO real secrets here and none belong here.

# Directory with the generated private files (absolute path, or relative to compose.yaml).
KANTAR_LOCAL_DIR=.local

# HTTPS port published on 127.0.0.1 (dev 8943, smoke gate 8953, e2e gate 8963).
KANTAR_HTTPS_PORT=8943

# Answer provider: Demo (deterministic, NOT a language model), LocalModel, or Disabled.
KANTAR_AI_PROVIDER=Demo

# Only for KANTAR_AI_PROVIDER=LocalModel: an OpenAI-compatible server that is ALREADY running on this
# machine or private network. Kantar never downloads, installs or starts a model, and it refuses any
# address that is not loopback or explicitly allow-listed below.
# From inside the api container the host is reachable as host.docker.internal, which is not a
# loopback name, so it must be allow-listed:
# KANTAR_AI_LOCAL_BASE_URL=http://host.docker.internal:11434
# KANTAR_AI_LOCAL_MODEL=<name of a model already present on that server>
# KANTAR_AI_LOCAL_ALLOWED_HOST=host.docker.internal
KANTAR_AI_LOCAL_BASE_URL=
KANTAR_AI_LOCAL_MODEL=
KANTAR_AI_LOCAL_ALLOWED_HOST=

# Rate limits (requests per minute). Raised only by the automated browser and smoke gates.
KANTAR_RATE_ANONYMOUS=30
KANTAR_RATE_USER=600
KANTAR_RATE_ASSIST=6

# Where the private files live after "local-stack init" (never commit them):
#   .local/sqlserver.env                      sa password for the SQL Server container
#   .local/secrets/*_connection               connection strings (bootstrap / migrator / app)
#   .local/secrets/csrf_key                   key that signs pre-login CSRF tokens
#   .local/secrets/https_certificate_password password of the exported development certificate
#   .local/seed/Seed__Passwords__<user>       demo user passwords, one file per user
#   .local/certs/kantar-dev.pfx               exported .NET development HTTPS certificate
# An optional bearer token for a local model server goes into a file of your choice outside the
# repository and is referenced with Ai__LocalModel__ApiKeyFile; it is not needed for Ollama or LM Studio.
