root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,slnx,ts,tsx,css,html,md}]
indent_size = 2

[*.ps1]
charset = utf-8-bom
end_of_line = crlf

[*.sh]
end_of_line = lf

# EF Core writes these files; they are not edited by hand and are not analysed.
[**/Persistence/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none

[tests/**/*.cs]
# Test method names use underscores to read as sentences.
dotnet_diagnostic.CA1707.severity = none
# Tests call the Async overloads with the test's own cancellation token only where it matters.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.xUnit1051.severity = none
