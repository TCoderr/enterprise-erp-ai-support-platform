{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Name": "kantar"
  },
  "Security": {
    "Sessions": {
      "IdleTimeout": "00:30:00",
      "AbsoluteLifetime": "08:00:00",
      "LockoutThreshold": 5,
      "LockoutDuration": "00:15:00",
      "PasswordMinLength": 12
    },
    "PasswordHashing": {
      "Iterations": 600000
    },
    "Web": {
      "TrustedProxies": [],
      "AnonymousRequestsPerMinute": 30,
      "UserRequestsPerMinute": 600,
      "AssistRequestsPerMinute": 6
    }
  }
}
